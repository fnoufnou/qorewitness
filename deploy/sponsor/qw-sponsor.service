[Unit]
Description=QoreWitness pilot fee sponsor (testnet only)
Documentation=file:///opt/qorewitness/docs/SPONSOR.md
After=network-online.target
Wants=network-online.target

[Service]
User=qw-sponsor
Group=qw-sponsor
WorkingDirectory=/opt/qorewitness
# Non-secret settings only. The recovery phrase stays in SPONSOR_SECRET_FILE (mode 600),
# which the service reads itself, so it never enters the process environment.
EnvironmentFile=/etc/qw-sponsor/sponsor.env
ExecStart=/usr/local/bin/pnpm -s tsx services/sponsor/main.ts
Restart=on-failure
RestartSec=60
# State, payout log and the PAUSED kill-switch file live here (mode 700).
StateDirectory=qw-sponsor
StateDirectoryMode=0700
# Own journal namespace with 14-day retention (journald@qw-sponsor.conf).
LogNamespace=qw-sponsor
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
