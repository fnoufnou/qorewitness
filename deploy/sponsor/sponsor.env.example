# /etc/qw-sponsor/sponsor.env (non-secret settings, mode 640, root:qw-sponsor)
# Testnet only. There is no setting for another network: the service refuses any
# EVM chain id but 9800 and any Cosmos network but qorechain-diana.

# Where the recovery phrase of the hot wallet is (mode 600, owner qw-sponsor).
SPONSOR_SECRET_FILE=/etc/qw-sponsor/secret.env
# One SHA-256 hash per line, made with: pnpm -s tsx services/sponsor/codes.ts new 5
SPONSOR_CODES_FILE=/etc/qw-sponsor/pilot-codes.txt
# State (state.json), payout log (payouts.jsonl) and the kill switch (PAUSED).
SPONSOR_DATA_DIR=/var/lib/qw-sponsor

# AnchorRegistry v4 on qorechain-diana
SPONSOR_REGISTRY=0xa1378D6558B32e1f8d37b68cf90e3C93839Da365
SPONSOR_EVM_RPC=https://evm-testnet.qore.host
SPONSOR_REST=https://api-testnet.qore.host
SPONSOR_RPC=https://rpc-testnet.qore.host

# HTTP: local only, nginx proxies /sponsor/ to it.
SPONSOR_HOST=127.0.0.1
SPONSOR_PORT=8787
SPONSOR_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# Top-up loop
SPONSOR_LOOP_MINUTES=15
SPONSOR_ACTIVE_WITHIN_SECONDS=7200
SPONSOR_THRESHOLD_QOR=10
SPONSOR_TARGET_QOR=15
SPONSOR_PER_ANCHOR_QOR=0.048
SPONSOR_MIN_WINDOW_SECONDS=600
SPONSOR_MIN_PAYOUT_QOR=0.5
SPONSOR_MIN_PAYOUT_INTERVAL_SECONDS=3600

# Caps (test QOR, per UTC day)
SPONSOR_CAP_CAMERA_DAY_QOR=9
SPONSOR_CAP_OWNER_DAY_QOR=18
SPONSOR_CAP_GLOBAL_DAY_QOR=90
SPONSOR_MAX_CAMERAS=12
SPONSOR_MAX_CAMERAS_PER_OWNER=2
# Automatic pause (writes the PAUSED file) when the last hour's payouts reach this.
SPONSOR_MAX_HOURLY_QOR=30

# Hot wallet float
SPONSOR_RESERVE_QOR=1
SPONSOR_MAX_FLOAT_QOR=200

# Device key lookup (blocks searched back for the registration or rotation tx)
SPONSOR_KEY_LOOKBACK_BLOCKS=120000
SPONSOR_LOG_CHUNK_BLOCKS=5000
