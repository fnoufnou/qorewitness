QW_DEVICE=lsc-indoor
QW_RTSP_URL=rtsp://192.168.1.162:8554/main
QW_SEGMENT_DIR=/var/lib/qorewitness/lsc-indoor/segments
QW_RECEIPT_DIR=/var/lib/qorewitness/lsc-indoor/receipts
QW_SEGMENT_SECONDS=60
QW_WINDOW_SECONDS=600
# ML-DSA-87 device key (64 hex chars, owner dev, mode 600). Create: pnpm device keygen <file>
QW_DEVICE_KEY=/etc/qorewitness/lsc-indoor.key
