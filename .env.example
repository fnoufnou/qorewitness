# Testnet only. Never put a mainnet or personal key here. Keep .env out of git.
# Testnet account (BIP-39 mnemonic, m/44'/60'/0'/0/0). Create one with scripts/new-account.ts.
QORE_MNEMONIC=
# PRIVATE_KEY=  (not for a real account: the SDK derives the ML-DSA-87 key from it, see README)
QORE_NETWORK=testnet
QORE_WINDOW_BLOCKS=600
QORE_WINDOW_TXS=5
