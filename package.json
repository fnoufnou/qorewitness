{
  "name": "qorewitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Post-quantum evidence anchor for camera footage on QoreChain",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "hardhat build --quiet && tsc --noEmit",
    "window": "tsx --env-file=.env scripts/window.ts",
    "probe:pqc": "tsx scripts/probe-pqc.ts",
    "probe:keystatus": "tsx scripts/probe-keystatus.ts",
    "deploy:testnet": "hardhat ignition deploy ignition/modules/AnchorRegistry.ts --network qorechainTestnet --deployment-id qorewitness-v3",
    "build:verifier": "node scripts/build-verifier.mjs",
    "device": "tsx --env-file=.env scripts/device.ts",
    "drill": "tsx scripts/qday-drill.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@noble/hashes": "2.0.1",
    "@qorechain/evm": "^0.12.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/sdk": "^0.12.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/hardhat-viem": "^3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.5",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/node": "^22.7.5",
    "esbuild": "0.25.12",
    "hardhat": "^3.21.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.47.6"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
